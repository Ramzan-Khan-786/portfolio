# Public build-time configuration. Never place secrets in VITE_* variables.
VITE_API_URL=/api
# Development proxy only; a production host must configure its own /api proxy.
VITE_PROXY_TARGET=http://localhost:5000
# Optional fallback for the associated typewriter project.
# Prefer the CMS Showroom Integration URL, which does not require rebuilding.
VITE_TYPEWRITER_URL=
