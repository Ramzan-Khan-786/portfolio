# Local development only. Never commit your actual .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ramzan_portfolio
# Comma-separated exact browser origins, without wildcard paths.
CLIENT_ORIGIN=http://localhost:5173
# Required in production: unique random secret, at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Number of trusted reverse-proxy hops; leave 0 for local direct access.
TRUST_PROXY=0
# Set both for the first seed. Existing passwords are never reset by seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional; used only when creating absent initial TypeWriter records.
TYPEWRITER_URL=
# Optional Google Identity Services web client ID (not a client secret).
GOOGLE_CLIENT_ID=
# Cloudinary is the canonical storage for new CMS uploads. Backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
# Opt in only if the account supports this transformation; charges may apply.
CLOUDINARY_BACKGROUND_REMOVAL_ENABLED=false
# Optional Drive picker import (drive.file scope). Enable Drive + Picker APIs.
# Restrict the browser-visible API key to frontend origins and required APIs.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
# Read-only legacy resume directory and local rotating logs. New uploads never write here.
UPLOAD_DIR=
LOG_DIR=
